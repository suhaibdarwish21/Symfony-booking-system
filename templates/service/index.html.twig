{% extends 'base.html.twig' %}

{% block title %}Services{% endblock %}

{% block body %}

<section class="services-page">

    <div class="services-container">

        <!-- HEADER -->
        <div class="services-header">

            <div class="services-header-left">

                <div class="header-icon">

                    <i class="fas fa-car-side"></i>

                </div>

                <div>

                    <span class="small-badge">

                        PREMIUM SERVICES

                    </span>

                    <h1 class="services-title">

                        Verfügbare Services

                    </h1>

                    <p class="services-subtitle">

                        Wähle deinen gewünschten Service
                        und buche deinen Termin online.

                    </p>

                </div>

            </div>

        </div>

        <!-- ALERTS -->
        {% for message in app.flashes('success') %}

            <div class="modern-alert success-alert">

                <i class="fas fa-check-circle"></i>

                {{ message }}

            </div>

        {% endfor %}

        {% for message in app.flashes('error') %}

            <div class="modern-alert error-alert">

                <i class="fas fa-exclamation-circle"></i>

                {{ message }}

            </div>

        {% endfor %}

        <!-- SERVICES -->
        <div class="services-grid">

            {% for service in services %}

                <div class="service-card">

                    <!-- IMAGE -->
                    <div class="service-image-wrapper">

                        {% if service.imageName %}

                            <img
                                src="{{ asset('uploads/services/' ~ service.imageName) }}"
                                class="service-image"
                                alt="{{ service.name }}"
                            >

                        {% else %}

                            <div class="service-placeholder">

                                <i class="fas fa-image"></i>

                            </div>

                        {% endif %}

                        <!-- HEART -->
                        <button class="heart-btn">

                            <i class="far fa-heart"></i>

                        </button>

                    </div>

                    <!-- CONTENT -->
                    <div class="service-content">

                        <!-- TITLE -->
                        <div class="service-top">

                            <h3 class="service-name">

                                {{ service.name }}

                            </h3>

                            <div class="service-price">

                                {{ service.price|number_format(0, '.', '.') }}€

                            </div>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="service-description">

                            {{ service.description|slice(0, 110) }}

                            {% if service.description|length > 110 %}
                                ...
                            {% endif %}

                        </div>

                        <!-- INFO -->
                        <div class="service-info">

                            <div class="info-box">

                                <i class="fas fa-clock"></i>

                                {{ service.durationMinutes }} Min

                            </div>

                            <div class="info-box">

                                <i class="fas fa-calendar"></i>

                                {{ service.timeSlots|length }} Zeiten

                            </div>

                        </div>

                        <!-- BUTTON -->
                        <a
                            href="{{ path('app_service_show', {id: service.id}) }}"
                            class="service-btn"
                        >

                            <i class="fas fa-search"></i>

                            Details & Buchen

                        </a>

                    </div>

                </div>

            {% else %}

                <div class="empty-box">

                    <i class="fas fa-inbox"></i>

                    <h3>

                        Keine Services verfügbar

                    </h3>

                    <p>

                        Bitte später erneut versuchen.

                    </p>

                </div>

            {% endfor %}

        </div>

    </div>

</section>

<style>

/* PAGE */

.services-page{
    padding-top:140px;
    padding-bottom:100px;
    min-height:100vh;
}

/* CONTAINER */

.services-container{
    width:100%;
    max-width:1600px;
    margin:auto;
    padding-left:40px;
    padding-right:40px;
}

/* HEADER */

.services-header{
    margin-bottom:70px;
}

.services-header-left{
    display:flex;
    align-items:center;
    gap:30px;
}

.header-icon{
    width:100px;
    height:100px;

    border-radius:30px;

    background:#edf3ff;

    display:flex;
    align-items:center;
    justify-content:center;
}

.header-icon i{
    font-size:45px;
    color:#2563eb;
}

.small-badge{
    background:#edf3ff;
    color:#2563eb;

    padding:10px 20px;

    border-radius:50px;

    font-size:14px;
    font-weight:700;
}

.services-title{
    font-size:72px;
    font-weight:800;

    color:#0f172a;

    margin-top:18px;
    margin-bottom:18px;

    line-height:1.05;
}

.services-subtitle{
    font-size:22px;
    color:#64748b;
}

/* ALERT */

.modern-alert{
    display:flex;
    align-items:center;
    gap:14px;

    padding:20px 25px;

    border-radius:20px;

    font-size:17px;
    font-weight:600;

    margin-bottom:20px;
}

.success-alert{
    background:#ecfdf3;
    color:#166534;
}

.error-alert{
    background:#fef2f2;
    color:#991b1b;
}

/* GRID */

.services-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:35px;
}

/* CARD */

.service-card{
    background:white;

    border-radius:35px;

    overflow:hidden;

    box-shadow:0 12px 35px rgba(0,0,0,0.06);

    transition:0.35s;

    display:flex;
    flex-direction:column;

    height:100%;
}

.service-card:hover{
    transform:translateY(-8px);
    box-shadow:0 25px 50px rgba(0,0,0,0.10);
}

/* IMAGE */

.service-image-wrapper{
    position:relative;
}

.service-image{
    width:100%;
    height:300px;
    object-fit:cover;
}

.service-placeholder{
    width:100%;
    height:300px;

    background:#edf2ff;

    display:flex;
    align-items:center;
    justify-content:center;
}

.service-placeholder i{
    font-size:70px;
    color:#94a3b8;
}

/* HEART */

.heart-btn{
    position:absolute;
    top:22px;
    right:22px;

    width:60px;
    height:60px;

    border:none;

    border-radius:50%;

    background:white;

    font-size:22px;

    display:flex;
    align-items:center;
    justify-content:center;

    box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

/* CONTENT */

.service-content{
    padding:30px;

    display:flex;
    flex-direction:column;

    flex:1;
}

/* TOP */

.service-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:20px;

    margin-bottom:20px;

    min-height:110px;
}

.service-name{
    font-size:32px;
    font-weight:800;
    color:#0f172a;

    line-height:1.15;

    flex:1;

    word-break:break-word;
}

.service-price{
    font-size:28px;
    font-weight:800;
    color:#2563eb;

    min-width:110px;

    text-align:right;

    flex-shrink:0;
}

/* DESCRIPTION */

.service-description{
    font-size:18px;
    line-height:1.8;
    color:#64748b;

    min-height:130px;

    margin-bottom:25px;
}

/* INFO */

.service-info{
    display:flex;
    gap:12px;

    flex-wrap:wrap;

    margin-top:auto;
    margin-bottom:25px;
}

.info-box{
    background:#f3f6fb;

    padding:12px 18px;

    border-radius:14px;

    font-size:15px;
    font-weight:700;

    color:#334155;
}

.info-box i{
    color:#2563eb;
    margin-right:8px;
}

/* BUTTON */

.service-btn{
    width:100%;

    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;

    background:#2563eb;
    color:white;

    text-decoration:none;

    padding:18px;

    border-radius:18px;

    font-size:18px;
    font-weight:700;

    transition:0.3s;
}

.service-btn:hover{
    background:#1d4ed8;
    color:white;

    transform:translateY(-2px);
}

/* EMPTY */

.empty-box{
    grid-column:1/-1;

    background:white;

    border-radius:35px;

    padding:80px;

    text-align:center;

    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.empty-box i{
    font-size:70px;
    color:#94a3b8;

    margin-bottom:25px;
}

.empty-box h3{
    font-size:38px;
    font-weight:800;

    margin-bottom:15px;
}

.empty-box p{
    font-size:20px;
    color:#64748b;
}

/* LAPTOP */

@media(max-width:1400px){

    .services-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .services-title{
        font-size:58px;
    }

}

/* TABLET */

@media(max-width:991px){

    .services-page{
        padding-top:120px;
    }

    .services-container{
        padding-left:20px;
        padding-right:20px;
    }

    .services-header-left{
        flex-direction:column;
        align-items:flex-start;
    }

    .header-icon{
        width:85px;
        height:85px;
    }

    .header-icon i{
        font-size:38px;
    }

    .services-title{
        font-size:48px;
    }

    .services-subtitle{
        font-size:18px;
    }

    .services-grid{
        grid-template-columns:1fr;
    }

    .service-image{
        height:260px;
    }

}

/* MOBILE */

@media(max-width:576px){

    .services-page{
        padding-top:100px;
    }

    .services-title{
        font-size:42px;
    }

    .service-content{
        padding:24px;
    }

    .service-top{
        flex-direction:column;
        gap:10px;

        min-height:auto;
    }

    .service-name{
        font-size:24px;
    }

    .service-price{
        font-size:26px;
        text-align:left;
        min-width:auto;
    }

    .service-description{
        font-size:16px;
        min-height:auto;
    }

    .info-box{
        width:100%;
        text-align:center;
    }

    .service-btn{
        font-size:16px;
        padding:16px;
    }

}

</style>

{% endblock %}