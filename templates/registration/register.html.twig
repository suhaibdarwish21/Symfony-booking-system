{% extends 'base.html.twig' %}

{% block title %}Registrieren - AutoCare{% endblock %}

{% block body %}

<section class="register-section">

    <div class="container">

        <div class="row align-items-center justify-content-center min-vh-100 py-5">

            <!-- LEFT SIDE -->
            <div class="col-lg-6 d-none d-lg-block">

                <div class="register-left">

                    <span class="premium-badge">

                        PREMIUM DETAILING

                    </span>

                    <h1>

                        Willkommen bei <br>
                        AutoCare

                    </h1>

                    <p>

                        Erstelle dein Konto und buche professionelle
                        Fahrzeugpflege ganz einfach online.

                    </p>

                    <div class="register-features">

                        <div class="feature-box">

                            <div class="feature-icon">

                                <i class="fas fa-car"></i>

                            </div>

                            <div>

                                <h5>Premium Services</h5>

                                <p>Professionelle Fahrzeugpflege</p>

                            </div>

                        </div>

                        <div class="feature-box">

                            <div class="feature-icon">

                                <i class="fas fa-calendar-check"></i>

                            </div>

                            <div>

                                <h5>Online Buchung</h5>

                                <p>Schnell und einfach Termine buchen</p>

                            </div>

                        </div>

                        <div class="feature-box">

                            <div class="feature-icon">

                                <i class="fas fa-shield-alt"></i>

                            </div>

                            <div>

                                <h5>Sicher & Modern</h5>

                                <p>Geschützte und moderne Plattform</p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- RIGHT SIDE -->
            <div class="col-lg-5 col-md-8 col-sm-10">

                <div class="register-card">

                    <div class="register-header text-center">

                        <div class="register-logo">

                            <i class="fas fa-user-plus"></i>

                        </div>

                        <h2>

                            Neues Konto erstellen

                        </h2>

                        <p>

                            Registrieren Sie sich, um Services zu buchen

                        </p>

                    </div>

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm, {
                        'attr': {
                            'novalidate': 'novalidate'
                        }
                    }) }}

                        <!-- EMAIL -->
                        <div class="form-group-custom">

                            <label>

                                E-Mail-Adresse

                            </label>

                            <div class="input-custom">

                                <i class="fas fa-envelope"></i>

                                {{ form_widget(registrationForm.email, {
                                    'attr': {
                                        'class': 'form-control custom-input',
                                        'placeholder': 'example@email.com'
                                    }
                                }) }}

                            </div>

                            {{ form_errors(registrationForm.email) }}

                        </div>

                        <!-- PASSWORD -->
                        <div class="form-group-custom">

                            <label>

                                Passwort

                            </label>

                            <div class="input-custom">

                                <i class="fas fa-lock"></i>

                                {{ form_widget(registrationForm.plainPassword, {
                                    'attr': {
                                        'class': 'form-control custom-input',
                                        'placeholder': 'Mindestens 8 Zeichen'
                                    }
                                }) }}

                            </div>

                            {{ form_errors(registrationForm.plainPassword) }}

                        </div>

                        <!-- TERMS -->
                        <div class="custom-check">

                            {{ form_widget(registrationForm.agreeTerms, {
                                'attr': {
                                    'class': 'form-check-input'
                                }
                            }) }}

                            <label for="{{ registrationForm.agreeTerms.vars.id }}">

                                Ich akzeptiere die

                                <a href="#">

                                    Bedingungen

                                </a>

                            </label>

                        </div>

                        {{ form_errors(registrationForm.agreeTerms) }}

                        <!-- BUTTON -->
                        <button type="submit" class="register-btn">

                            <i class="fas fa-user-check"></i>

                            Registrieren

                        </button>

                    {{ form_end(registrationForm) }}

                    <div class="divider">

                        <span>

                            ODER

                        </span>

                    </div>

                    <a href="{{ path('app_login') }}" class="login-btn">

                        <i class="fas fa-sign-in-alt"></i>

                        Bereits ein Konto? Anmelden

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<style>

.register-section{

    background: linear-gradient(
        135deg,
        #f8fafc 0%,
        #eef2ff 100%
    );

    min-height: 100vh;

    overflow: hidden;
}

/* LEFT SIDE */

.register-left{

    padding-right: 50px;
}

.premium-badge{

    display: inline-block;

    background: rgba(37,99,235,0.1);

    color: #2563eb;

    padding: 12px 22px;

    border-radius: 50px;

    font-weight: 700;

    font-size: 14px;

    margin-bottom: 25px;
}

.register-left h1{

    font-size: 68px;

    font-weight: 900;

    line-height: 1.1;

    color: #0f172a;

    margin-bottom: 25px;
}

.register-left p{

    font-size: 20px;

    color: #64748b;

    line-height: 1.8;

    margin-bottom: 40px;
}

.register-features{

    display: flex;

    flex-direction: column;

    gap: 20px;
}

.feature-box{

    display: flex;

    align-items: center;

    gap: 18px;

    background: white;

    padding: 20px;

    border-radius: 22px;

    box-shadow: 0 10px 35px rgba(0,0,0,0.06);

    transition: 0.3s ease;
}

.feature-box:hover{

    transform: translateY(-5px);
}

.feature-icon{

    width: 65px;

    height: 65px;

    border-radius: 18px;

    background: linear-gradient(
        135deg,
        #2563eb,
        #3b82f6
    );

    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    font-size: 24px;
}

.feature-box h5{

    font-weight: 800;

    margin-bottom: 5px;

    color: #0f172a;
}

.feature-box p{

    margin: 0;

    font-size: 15px;

    color: #64748b;
}

/* CARD */

.register-card{

    background: white;

    padding: 50px;

    border-radius: 35px;

    box-shadow: 0 20px 60px rgba(0,0,0,0.08);

    position: relative;
}

.register-header{

    margin-bottom: 35px;
}

.register-logo{

    width: 90px;

    height: 90px;

    border-radius: 28px;

    background: linear-gradient(
        135deg,
        #2563eb,
        #3b82f6
    );

    display: flex;

    align-items: center;

    justify-content: center;

    margin: 0 auto 25px;

    color: white;

    font-size: 34px;

    box-shadow: 0 15px 35px rgba(37,99,235,0.3);
}

.register-header h2{

    font-size: 36px;

    font-weight: 900;

    color: #0f172a;

    margin-bottom: 10px;
}

.register-header p{

    color: #64748b;

    font-size: 16px;
}

/* INPUTS */

.form-group-custom{

    margin-bottom: 25px;
}

.form-group-custom label{

    display: block;

    margin-bottom: 10px;

    font-weight: 700;

    color: #0f172a;
}

.input-custom{

    position: relative;
}

.input-custom i{

    position: absolute;

    top: 50%;

    left: 20px;

    transform: translateY(-50%);

    color: #2563eb;

    font-size: 16px;
}

.custom-input{

    height: 60px;

    border-radius: 18px;

    border: 2px solid #e2e8f0;

    padding-left: 55px;

    font-size: 16px;

    transition: 0.3s ease;

    box-shadow: none;
}

.custom-input:focus{

    border-color: #2563eb;

    box-shadow: 0 0 0 5px rgba(37,99,235,0.12);
}

/* CHECKBOX */

.custom-check{

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 25px;
}

.custom-check label{

    color: #64748b;
}

.custom-check a{

    color: #2563eb;

    text-decoration: none;

    font-weight: 700;
}

/* BUTTONS */

.register-btn{

    width: 100%;

    height: 60px;

    border: none;

    border-radius: 18px;

    background: linear-gradient(
        135deg,
        #2563eb,
        #3b82f6
    );

    color: white;

    font-size: 17px;

    font-weight: 800;

    transition: 0.3s ease;

    box-shadow: 0 15px 35px rgba(37,99,235,0.3);
}

.register-btn:hover{

    transform: translateY(-3px);

    box-shadow: 0 20px 40px rgba(37,99,235,0.4);
}

.divider{

    text-align: center;

    margin: 30px 0;

    position: relative;
}

.divider::before{

    content: "";

    position: absolute;

    top: 50%;

    left: 0;

    width: 100%;

    height: 1px;

    background: #e2e8f0;
}

.divider span{

    background: white;

    position: relative;

    padding: 0 15px;

    color: #94a3b8;

    font-weight: 700;
}

.login-btn{

    width: 100%;

    height: 58px;

    border-radius: 18px;

    border: 2px solid #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    text-decoration: none;

    color: #2563eb;

    font-weight: 800;

    transition: 0.3s ease;
}

.login-btn:hover{

    background: #2563eb;

    color: white;
}

/* MOBILE */

@media(max-width: 991px){

    .register-card{

        padding: 35px 25px;
    }

    .register-header h2{

        font-size: 30px;
    }
}

@media(max-width: 576px){

    .register-section{

        padding: 30px 10px;
    }

    .register-card{

        border-radius: 25px;

        padding: 30px 20px;
    }

    .register-logo{

        width: 75px;

        height: 75px;

        font-size: 28px;
    }

    .register-header h2{

        font-size: 26px;
    }

    .custom-input{

        height: 55px;
    }

    .register-btn{

        height: 55px;
    }

    .login-btn{

        height: 55px;
    }
}

</style>

{% endblock %}