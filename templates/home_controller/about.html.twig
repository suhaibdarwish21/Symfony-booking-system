{% extends 'base.html.twig' %}

{% block title %}Über Uns{% endblock %}

{% block body %}

<!-- HERO -->
<section class="about-hero">

    <div class="about-container">

        <div class="about-grid">

            <!-- LEFT -->
            <div class="about-left">

                <span class="about-badge">

                    ✨ ÜBER UNS

                </span>

                <h1 class="about-title">

                    Premium Pflege
                    für jedes Fahrzeug

                </h1>

                <p class="about-text">

                    Wir bieten professionelle Fahrzeugpflege,
                    moderne Autoaufbereitung und Premium Detailing
                    mit hochwertigen Produkten und maximaler Qualität.

                </p>

                <div class="about-buttons">

                    <a href="{{ path('app_services') }}"
                       class="about-btn-primary">

                        <i class="fas fa-car me-2"></i>

                        Services ansehen

                    </a>

                    <a href="#stats"
                       class="about-btn-secondary">

                        Mehr erfahren

                    </a>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="about-right">

                <div class="about-image-wrapper">

                    <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=1800&auto=format&fit=crop"
                         class="about-image"
                         alt="Car Detailing">

                    <!-- CARD -->
                    <div class="floating-box box-one">

                        <i class="fas fa-users"></i>

                        <h5>

                            500+ Kunden

                        </h5>

                    </div>

                    <!-- CARD -->
                    <div class="floating-box box-two">

                        <i class="fas fa-star"></i>

                        <h5>

                            99% Zufriedenheit

                        </h5>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- STATS -->
<section class="stats-section"
         id="stats">

    <div class="about-container">

        <div class="stats-grid">

            <!-- ITEM -->
            <div class="stats-card">

                <h2>

                    500+

                </h2>

                <p>

                    Zufriedene Kunden

                </p>

            </div>

            <!-- ITEM -->
            <div class="stats-card">

                <h2>

                    1200+

                </h2>

                <p>

                    Erfolgreiche Fahrzeugpflege

                </p>

            </div>

            <!-- ITEM -->
            <div class="stats-card">

                <h2>

                    99%

                </h2>

                <p>

                    Positive Bewertungen

                </p>

            </div>

            <!-- ITEM -->
            <div class="stats-card">

                <h2>

                    24/7

                </h2>

                <p>

                    Online Buchung

                </p>

            </div>

        </div>

    </div>

</section>

<!-- WHY -->
<section class="why-section">

    <div class="about-container">

        <div class="section-top">

            <span class="section-badge">

                WARUM WIR

            </span>

            <h2 class="section-title">

                Warum Kunden uns wählen

            </h2>

            <p class="section-text">

                Premium Fahrzeugpflege
                mit modernster Technik.

            </p>

        </div>

        <div class="why-grid">

            <!-- ITEM -->
            <div class="why-card">

                <div class="why-icon">

                    <i class="fas fa-soap"></i>

                </div>

                <h3>

                    Premium Reinigung

                </h3>

                <p>

                    Professionelle Innen- und Außenreinigung
                    für maximalen Glanz.

                </p>

            </div>

            <!-- ITEM -->
            <div class="why-card">

                <div class="why-icon">

                    <i class="fas fa-shield-alt"></i>

                </div>

                <h3>

                    Lackschutz

                </h3>

                <p>

                    Hochwertige Versiegelung
                    für langfristigen Schutz.

                </p>

            </div>

            <!-- ITEM -->
            <div class="why-card">

                <div class="why-icon">

                    <i class="fas fa-bolt"></i>

                </div>

                <h3>

                    Schneller Service

                </h3>

                <p>

                    Flexible Termine
                    ohne lange Wartezeiten.

                </p>

            </div>

        </div>

    </div>

</section>

<!-- TEAM -->
<section class="team-section">

    <div class="about-container">

        <div class="section-top">

            <span class="section-badge">

                UNSER TEAM

            </span>

            <h2 class="section-title">

                Professionelle Auto Experten

            </h2>

        </div>

        <div class="team-grid">

            <!-- MEMBER -->
            <div class="team-card">

                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1200&auto=format&fit=crop"
                     class="team-image"
                     alt="">

                <div class="team-content">

                    <h3>

                        Max Müller

                    </h3>

                    <p>

                        Fahrzeugpflege Experte

                    </p>

                </div>

            </div>

            <!-- MEMBER -->
            <div class="team-card">

                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=1200&auto=format&fit=crop"
                     class="team-image"
                     alt="">

                <div class="team-content">

                    <h3>

                        Anna Becker

                    </h3>

                    <p>

                        Kundenservice

                    </p>

                </div>

            </div>

            <!-- MEMBER -->
            <div class="team-card">

                <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=1200&auto=format&fit=crop"
                     class="team-image"
                     alt="">

                <div class="team-content">

                    <h3>

                        David Wagner

                    </h3>

                    <p>

                        Detailing Spezialist

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- CTA -->
<section class="cta-section">

    <div class="about-container">

        <div class="cta-box">

            <h2>

                Dein Fahrzeug verdient Premium Pflege

            </h2>

            <p>

                Buche jetzt deinen Termin
                und bring dein Auto zum Glänzen.

            </p>

            <a href="{{ path('app_services') }}"
               class="cta-btn">

                Jetzt buchen

            </a>

        </div>

    </div>

</section>

<style>

.about-hero{
    padding-top:170px;
    padding-bottom:120px;
}

.about-container{
    width:100%;
    max-width:1700px;
    margin:auto;
    padding-left:70px;
    padding-right:70px;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    align-items:center;
    gap:100px;
}

.about-badge{
    background:#edf3ff;
    color:#2563eb;
    padding:14px 24px;
    border-radius:50px;
    font-weight:700;
}

.about-title{
    font-size:90px;
    line-height:1.05;
    font-weight:800;
    color:#0f172a;
    margin-top:35px;
    margin-bottom:30px;
}

.about-text{
    font-size:28px;
    line-height:1.9;
    color:#64748b;
    max-width:700px;
}

.about-buttons{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
    margin-top:50px;
}

.about-btn-primary{
    background:#2563eb;
    color:white;
    padding:22px 36px;
    border-radius:22px;
    font-size:18px;
    font-weight:700;
}

.about-btn-secondary{
    background:white;
    color:#0f172a;
    padding:22px 36px;
    border-radius:22px;
    font-size:18px;
    font-weight:700;
    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.about-image-wrapper{
    position:relative;
}

.about-image{
    width:100%;
    height:750px;
    object-fit:cover;
    border-radius:50px;
}

.floating-box{
    position:absolute;
    background:white;
    border-radius:28px;
    padding:28px 32px;
    box-shadow:0 20px 50px rgba(0,0,0,0.08);
}

.floating-box i{
    font-size:30px;
    color:#2563eb;
    margin-bottom:15px;
}

.floating-box h5{
    font-size:26px;
    font-weight:800;
}

.box-one{
    left:-60px;
    top:60px;
}

.box-two{
    right:-50px;
    bottom:60px;
}

.stats-section{
    padding-bottom:120px;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:30px;
}

.stats-card{
    background:white;
    border-radius:35px;
    padding:50px;
    text-align:center;
    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.stats-card h2{
    font-size:70px;
    font-weight:800;
    color:#2563eb;
    margin-bottom:15px;
}

.stats-card p{
    font-size:20px;
    color:#64748b;
}

.section-top{
    text-align:center;
    margin-bottom:70px;
}

.section-badge{
    background:#edf3ff;
    color:#2563eb;
    padding:12px 22px;
    border-radius:50px;
    font-size:15px;
    font-weight:700;
}

.section-title{
    font-size:70px;
    font-weight:800;
    color:#0f172a;
    margin-top:30px;
    margin-bottom:20px;
}

.section-text{
    font-size:24px;
    color:#64748b;
}

.why-section{
    padding-bottom:120px;
}

.why-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:35px;
}

.why-card{
    background:white;
    border-radius:35px;
    padding:50px;
    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.why-icon{
    width:90px;
    height:90px;
    border-radius:24px;
    background:#edf3ff;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:35px;
}

.why-icon i{
    font-size:34px;
    color:#2563eb;
}

.why-card h3{
    font-size:34px;
    font-weight:800;
    margin-bottom:18px;
}

.why-card p{
    color:#64748b;
    line-height:1.9;
    font-size:18px;
}

.team-section{
    padding-bottom:120px;
}

.team-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:35px;
}

.team-card{
    background:white;
    border-radius:35px;
    overflow:hidden;
    box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

.team-image{
    width:100%;
    height:420px;
    object-fit:cover;
}

.team-content{
    padding:35px;
}

.team-content h3{
    font-size:34px;
    font-weight:800;
    margin-bottom:12px;
}

.team-content p{
    color:#64748b;
    font-size:18px;
}

.cta-section{
    padding-bottom:120px;
}

.cta-box{
    background:#2563eb;
    border-radius:50px;
    padding:100px;
    text-align:center;
    color:white;
}

.cta-box h2{
    font-size:70px;
    font-weight:800;
    margin-bottom:25px;
}

.cta-box p{
    font-size:24px;
    margin-bottom:40px;
    opacity:0.9;
}

.cta-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:white;
    color:#2563eb;
    padding:24px 40px;
    border-radius:24px;
    font-size:20px;
    font-weight:800;
}

@media(max-width:1400px){

    .about-grid{
        grid-template-columns:1fr;
    }

    .stats-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .why-grid{
        grid-template-columns:1fr;
    }

    .team-grid{
        grid-template-columns:1fr;
    }

}

@media(max-width:768px){

    .about-container{
        padding-left:20px;
        padding-right:20px;
    }

    .about-title{
        font-size:54px;
    }

    .about-text{
        font-size:20px;
    }

    .section-title{
        font-size:44px;
    }

    .stats-grid{
        grid-template-columns:1fr;
    }

    .floating-box{
        display:none;
    }

    .about-image{
        height:500px;
    }

    .cta-box{
        padding:60px 30px;
    }

    .cta-box h2{
        font-size:42px;
    }

}

</style>

{% endblock %}